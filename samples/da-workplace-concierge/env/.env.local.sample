# This file includes environment variables that will be committed to git by default.
# Copy it to env/.env.local (the Agents Toolkit also creates that file on first
# local run). env/.env.local is gitignored because provisioning writes your
# tenant's app IDs and your dev tunnel URL into it.

# Built-in environment variables
TEAMSFX_ENV=local
APP_NAME_SUFFIX=local

# Generated during provision, you can also add your own variables.
