# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# The Azure AI Search service that hosts your Foundry IQ knowledge base.
# This service can live in a DIFFERENT Microsoft Entra directory (tenant)
# than your Microsoft 365 Copilot tenant. Example: https://contoso-search.search.windows.net
FOUNDRY_IQ_SEARCH_ENDPOINT=

# The name of the knowledge base created in Azure AI Search / Microsoft Foundry.
FOUNDRY_IQ_KNOWLEDGE_BASE_NAME=

# Generated during provision, you can also add your own variables.
TEAMS_APP_ID=
APIKEY_REGISTRATION_ID=
TEAMS_APP_TENANT_ID=
M365_TITLE_ID=
M365_APP_ID=
